APP_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=churrasplan
# DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/churrasplan?charset=utf8mb4
AUTO_CREATE_SCHEMA=false
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Autenticação
SESSION_COOKIE_NAME=churrasplan_session
CSRF_COOKIE_NAME=churrasplan_csrf
SESSION_DAYS=30
COOKIE_SECURE=false
REQUIRE_EMAIL_VERIFICATION=false
PUBLIC_APP_URL=http://127.0.0.1:5500

# E-mail (opcional em desenvolvimento)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ChurrasPlan <no-reply@churrasplan.local>
SMTP_TLS=true

# Google Maps / Places (opcional)
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_JS_API_KEY=
GOOGLE_MAP_ID=

# Pool MySQL
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Hardening de produção
TRUSTED_HOSTS=localhost,127.0.0.1
FORCE_HTTPS=false
HSTS_SECONDS=31536000
MAX_REQUEST_BODY_BYTES=2097152
TRUST_PROXY_HEADERS=false
SECURITY_PEPPER=development-pepper-change-before-production-123456789
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_ATTEMPTS=10
RATE_LIMIT_REGISTER_ATTEMPTS=8
RATE_LIMIT_PUBLIC_ATTEMPTS=30
RATE_LIMIT_WINDOW_SECONDS=900
SECURITY_EVENT_RETENTION_DAYS=7

# Documentos legais versionados
TERMS_VERSION=2026-09-18
PRIVACY_VERSION=2026-09-21
