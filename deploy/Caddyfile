{$APP_DOMAIN} {
    encode zstd gzip

    @api path /api/* /docs* /redoc* /openapi.json
    reverse_proxy @api backend:8000
    reverse_proxy frontend:80

    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
}
