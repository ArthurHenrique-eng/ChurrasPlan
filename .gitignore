# ============================================================
# ChurrasPlan - .gitignore
# Python + FastAPI + MySQL + Playwright + Docker + Frontend
# ============================================================


# ============================================================
# ENVIRONMENT / SECRETS
# ============================================================

# Arquivos reais de ambiente
.env
.env.*
.envrc

# Exemplos de configuração DEVEM ir para o Git
!.env.example
!.env.docker.example
!.env.production.example
!BackEnd/Python/.env.example

# Credenciais / chaves privadas
*.key
*.pem
*.p12
*.pfx

# Possíveis arquivos de credenciais locais
credentials.json
credentials*.json
service-account*.json
google-credentials*.json
.secrets/
secrets/


# ============================================================
# PYTHON
# ============================================================

__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Ambientes virtuais
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.conda/

# PEP 582
__pypackages__/

# Python version managers
# .python-version


# ============================================================
# TESTES / COVERAGE / CACHE
# ============================================================

.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
*.cover
*.py.cover
cover/

.tox/
.nox/
.hypothesis/

.cache/
.mypy_cache/
.dmypy.json
dmypy.json

.pyre/
.pytype/
.ruff_cache/

cython_debug/


# ============================================================
# PLAYWRIGHT / E2E
# ============================================================

test-results/
playwright-report/
blob-report/

# Screenshots/videos temporários gerados por testes
e2e/test-results/
e2e/playwright-report/


# ============================================================
# DATABASES / BACKUPS / DUMPS LOCAIS
# ============================================================

*.db
*.sqlite
*.sqlite3
*.sqlite3-journal

*.sql.gz
*.dump
*.backup
*.bak

backups/
backup/

# Dados locais de banco/container
mysql-data/
mysql_data/
.mysql/


# ============================================================
# IMPORTANTE:
# NÃO ignorar *.sql globalmente.
#
# Estes arquivos do ChurrasPlan DEVEM continuar no Git:
#
# BackEnd/Python/sql/schema.sql
# BackEnd/Python/sql/seed_data.sql
# migrations Alembic
# ============================================================


# ============================================================
# LOGS / TEMPORÁRIOS / RUNTIME
# ============================================================

*.log
*.tmp
*.temp
*.pid

logs/
tmp/
temp/

pip-log.txt
pip-delete-this-directory.txt

tempCodeRunnerFile.py


# ============================================================
# PYTHON BUILD / PACKAGING
# ============================================================

.Python
build/
dist/
downloads/
develop-eggs/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/

*.egg-info/
.installed.cfg
*.egg

MANIFEST

# PyInstaller
*.manifest
*.spec


# ============================================================
# NODE / FRONTEND TOOLING
# ============================================================

node_modules/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.npm/
.pnpm-store/

# NÃO ignorar:
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
# Esses arquivos ajudam a reproduzir builds.


